# Copy to .env (gitignored). Real values live in SSM Parameter Store on EC2.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Deployment routing (org deployment names, e.g. gpt-5.6-sol / gpt-5.6-terra)
LANTERN_MODEL_REASONING=
LANTERN_MODEL_FAST=

# Orchestration DB (docs/ORCHESTRATION.md)
LANTERN_DATABASE_URL=postgresql+asyncpg://lantern:CHANGE-ME@localhost:5432/lantern

# Runner affinity (docs/plans/ui-ux-agent-paper.md). 'ec2' on the EC2 box;
# 'workstation' on the design machine running Paper Desktop.
LANTERN_RUNNER=ec2
LANTERN_PAPER_MCP_URL=http://127.0.0.1:29979/mcp

# QA targets — two layers (P0.1):
#  - QA_BASE_URL/QA_USER/QA_PASS: what a QA session itself reads (inprocess/laptop runs)
#  - LANTERN_QA_DEV_* / LANTERN_QA_STAGING_*: DISPATCHER env (EC2, from SSM
#    /lantern/qa/{dev,staging}/*) — mapped per-stage into containers as QA_*
QA_BASE_URL=
QA_USER=
QA_PASS=
LANTERN_QA_DEV_BASE_URL=
LANTERN_QA_DEV_USER=
LANTERN_QA_DEV_PASS=
LANTERN_QA_STAGING_BASE_URL=
LANTERN_QA_STAGING_USER=
LANTERN_QA_STAGING_PASS=

# Product repository (P0.3). The run's own target wins (brief field / `set-product`);
# these are only the default for a box that works on a single product. The PAT stays
# host-side: it authenticates the mirror fetch and never enters a sandbox.
LANTERN_PRODUCT_REPO=
LANTERN_PRODUCT_BRANCH=main
LANTERN_PRODUCT_MIRROR_DIR=

# Artifact storage — bucket NAME only; the dispatcher uploads stage media to
# s3://$LANTERN_ARTIFACT_BUCKET/lantern/<run-id>/<stage>/ after postconditions pass.
# Unset = media stays local (dev). MIGRATION: replaces the old ARTIFACT_BUCKET
# (which held a full s3://.../lantern prefix) — the old key is ignored; put the
# bare bucket name here or uploads silently skip.
LANTERN_ARTIFACT_BUCKET=

# Token ledger + spend tripwires (P0.4) — see README "Env-var contract"
LANTERN_PRICE_IN_PER_M=4
LANTERN_PRICE_CACHED_IN_PER_M=1
LANTERN_PRICE_OUT_PER_M=20
LANTERN_DAILY_SPEND_ALARM_USD=50
LANTERN_CREDIT_POOL_USD=25000
LANTERN_POOL_SPENT_OFFSET_USD=0
LANTERN_ALARM_WEBHOOK=

# Agent-owned Paper file (design workstation) — one page per run inside it.
LANTERN_PAPER_FILE_ID=
