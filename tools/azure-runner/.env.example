# Copy to .env (gitignored). Real values live in SSM Parameter Store on EC2.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Deployment routing (org deployment names, e.g. sol / terra)
LANTERN_MODEL_REASONING=
LANTERN_MODEL_FAST=

# QA targets
QA_BASE_URL=
QA_USER=
QA_PASS=

# Artifact storage
ARTIFACT_BUCKET=s3://YOUR-BUCKET/lantern
