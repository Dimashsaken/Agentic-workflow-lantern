# Copy to .env for local development. Never commit .env.
TENDER_SECRET_KEY=change-me                 # signs session cookies
TENDER_DATABASE_URL=sqlite:///./tender.db   # SQLAlchemy URL; Postgres in production
# WhatsApp Business (Meta Cloud API) — leave blank to use the built-in sandbox channel
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Assistant model (Azure OpenAI) — leave blank to use the rule-based assistant
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
