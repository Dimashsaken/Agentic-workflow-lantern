            {
              "id": "CVE-2026-1703",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-1703: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-1703?s=github&n=pip&t=pypi&vr=%3C26.0",
              "help": {
                "text": "When pip is installing and extracting a maliciously crafted wheel archive, files may be extracted outside the installation directory. The path traversal is limited to prefixes of the installation directory, thus isn't able to inject or overwrite executable files in typical situations.\n",
                "markdown": "> When pip is installing and extracting a maliciously crafted wheel archive, files may be extracted outside the installation directory. The path traversal is limited to prefixes of the installation directory, thus isn't able to inject or overwrite executable files in typical situations.\n\n|                                                                                                                     |\n|Package                                                                                           pkg:pypi/pip@24.0  |\n|Affected range                                                                                    <26.0              |\n|Fixed version                                                                                     26.0               |\n|[[CVSS Score 2.0] [CVSS Vector CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:A/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N]]                     |\n"
              },
              "properties": {
                "affected_version": ">=0",
                "cvssV3_severity": "LOW",
                "fixed_version": "not fixed",
                "purls": [
                  "pkg:deb/ubuntu/python-pip@24.0%2Bdfsg-1ubuntu1.3?os_distro=noble&os_name=ubuntu&os_version=24.04",
                  "pkg:pypi/pip@24.0"
                ],
                "security-severity": "3.1",
                "tags": [
                  "LOW"
                ]
              }
